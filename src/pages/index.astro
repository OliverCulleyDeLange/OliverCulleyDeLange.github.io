---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MacIcon from '../components/MacIcon.astro';
import ProjectExplainer from '../components/ProjectExplainer.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout windowTitle="Macintosh HD" wide>
  <ProjectExplainer />

  <section class="post-list" id="posts">
    <h2 class="section-heading">Documents</h2>
    <div class="list-head" aria-hidden="true">
      <span>Name</span>
      <span>Date Modified</span>
    </div>
    <ul>
      {posts.map(post => {
        const formattedDate = post.data.date.toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });
        return (
          <li>
            <a href={`/posts/${post.id}/`}>
              <span class="post-title">
                <MacIcon name="doc" size={16} />
                {post.data.title}
              </span>
              <time class="post-date" datetime={post.data.date.toISOString()}>{formattedDate}</time>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
