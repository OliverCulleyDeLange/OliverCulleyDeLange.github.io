---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pinball"
  description="A small single-table pinball machine, built with canvas — no libraries."
  windowTitle="Pinball"
  wide
>
  <section class="game-stage pinball-stage" aria-label="Pinball">
    <div class="game-hud pinball-hud">
      <span class="game-score" id="pinball-score">0</span>
      <span class="pinball-lives" id="pinball-lives" aria-label="Balls remaining"></span>
      <span class="pinball-high" id="pinball-high"></span>
    </div>
    <p class="game-message" id="pinball-message" role="status" aria-live="polite"></p>
    <ul class="pinball-legend">
      <li><span class="legend-dot" data-kind="grey"></span>Slows</li>
      <li><span class="legend-dot" data-kind="green"></span>Speeds up</li>
      <li><span class="legend-dot" data-kind="red"></span>Swallows / respawns</li>
      <li><span class="legend-dot" data-kind="yellow"></span>Zaps random</li>
      <li><span class="legend-dot" data-kind="purple"></span>Splits ball</li>
      <li><span class="legend-dot" data-kind="pink"></span>Spawns obstacle</li>
    </ul>
    <div class="game-canvas-wrap pinball-canvas-wrap">
      <canvas
        id="pinball-canvas"
        class="game-canvas"
        aria-label="Pinball table. Left arrow or Z for the left flipper, right arrow or X for the right flipper, space to launch or start, escape to restart with a reshuffled table."
      ></canvas>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Shared .game-stage / .game-hud / .game-canvas rules live in
     global.css; this page only fixes its own canvas's shape, plus its
     slightly busier HUD (score, lives, high score) and colour key. The
     table itself has no width cap — it fills whatever room the window
     gives it once the HUD/message/legend above have taken their share
     (.game-canvas-wrap is the flexible one, from global.css). */
  .pinball-hud {
    width: 100%;
    max-width: 560px;
    justify-content: space-between;
  }

  .pinball-lives {
    letter-spacing: 0.15em;
  }

  .pinball-high {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pinball-canvas-wrap .game-canvas { aspect-ratio: 360 / 620; }

  /* Colour key for the obstacles, sat right above the table. Colours are
     duplicated from BUMPER_KINDS in scripts/games/pinball.ts — keep the two
     in sync if either changes. */
  .pinball-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2rem 0.7rem;
    width: 100%;
    max-width: 560px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .pinball-legend li {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .legend-dot[data-kind="grey"] { background: #9aa1a9; }
  .legend-dot[data-kind="green"] { background: #22c55e; }
  .legend-dot[data-kind="red"] { background: #ef4444; }
  .legend-dot[data-kind="yellow"] { background: #eab308; }
  .legend-dot[data-kind="purple"] { background: #a855f7; }
  .legend-dot[data-kind="pink"] { background: #ec4899; }
</style>

<script>
  import { createPinball } from '../scripts/games/pinball';

  const canvas = document.getElementById('pinball-canvas') as HTMLCanvasElement;
  const scoreEl = document.getElementById('pinball-score') as HTMLElement;
  const livesEl = document.getElementById('pinball-lives') as HTMLElement;
  const highEl = document.getElementById('pinball-high') as HTMLElement;
  const messageEl = document.getElementById('pinball-message') as HTMLElement;

  createPinball(canvas, {
    setScore(score) {
      scoreEl.textContent = String(score);
    },
    setLives(lives) {
      livesEl.textContent = '●'.repeat(Math.max(lives, 0));
    },
    setHighScore(score) {
      highEl.textContent = score > 0 ? `Best: ${score}` : '';
    },
    setMessage(text) {
      messageEl.textContent = text ?? '';
    },
  });
</script>
