---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pinball"
  description="A small single-table pinball machine, built with canvas — no libraries. Lay out the bumpers yourself."
  windowTitle="Pinball"
  wide
>
  <section class="game-stage pinball-stage" aria-label="Pinball">
    <div class="game-hud pinball-hud">
      <span class="game-score" id="pinball-score">0</span>
      <span class="pinball-lives" id="pinball-lives" aria-label="Balls remaining"></span>
      <span class="pinball-high" id="pinball-high"></span>
    </div>
    <p class="game-message" id="pinball-message" role="status" aria-live="polite"></p>
    <ul class="pinball-palette" id="pinball-palette" aria-label="Bumper palette. Pick a colour, then click the table to place it.">
      <li><button type="button" data-kind="green" aria-pressed="false"><span class="legend-dot"></span>Speeds up</button></li>
      <li><button type="button" data-kind="red" aria-pressed="false"><span class="legend-dot"></span>Swallows</button></li>
      <li><button type="button" data-kind="purple" aria-pressed="false"><span class="legend-dot"></span>Splits</button></li>
      <li><button type="button" data-kind="hole" aria-pressed="false"><span class="legend-dot"></span>Hole</button></li>
    </ul>
    <p class="pinball-hint">Pick an item, then click the table to place it. Drag the middle to move, the rim to resize, double-click to remove. Swallowed balls come back out of a hole.</p>
    <div class="game-canvas-wrap pinball-canvas-wrap">
      <canvas
        id="pinball-canvas"
        class="game-canvas"
        aria-label="Pinball table. Left arrow or Z for the left flipper, right arrow or X for the right flipper. Hold down arrow to charge the plunger and release to launch, or press space for a full-power launch. Escape restarts. Green bumpers speed the ball up, purple ones split it, and red ones swallow it so it reappears from one of the holes."
      ></canvas>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Shared .game-stage / .game-hud / .game-canvas rules live in
     global.css; this page only fixes its own canvas's shape, plus its
     slightly busier HUD (score, lives, high score) and the bumper palette.
     The table itself has no width cap — it fills whatever room the window
     gives it once the HUD/message/palette above have taken their share
     (.game-canvas-wrap is the flexible one, from global.css). */
  .pinball-hud {
    width: 100%;
    max-width: 560px;
    justify-content: space-between;
  }

  .pinball-lives {
    letter-spacing: 0.15em;
  }

  .pinball-high {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pinball-canvas-wrap .game-canvas {
    aspect-ratio: 360 / 620;
    border-radius: 10px;
    border-color: #3b4560;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  /* Palette of bumper colours. Colours are duplicated from BUMPER_KINDS in
     scripts/games/pinball.ts — keep the two in sync if either changes. */
  .pinball-palette {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.4rem;
    width: 100%;
    max-width: 560px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.7rem;
  }

  .pinball-palette button {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    font: inherit;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
  }

  .pinball-palette button:hover { color: var(--text); border-color: var(--ink); }

  .pinball-palette button[aria-pressed="true"] {
    color: var(--text);
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .pinball-palette button.placed { color: var(--text); }

  .pinball-palette .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: 0 0 auto;
    box-sizing: border-box;
    border: 2px solid var(--dot);
    background: transparent;
  }

  .pinball-palette button.placed .legend-dot { background: var(--dot); }

  .pinball-palette button[data-kind="green"] { --dot: #34d399; }
  .pinball-palette button[data-kind="red"] { --dot: #f87171; }
  .pinball-palette button[data-kind="purple"] { --dot: #c084fc; }
  .pinball-palette button[data-kind="hole"] { --dot: #dfe7f5; }
  .pinball-palette button[data-kind="hole"] .legend-dot { background: #05070f; }

  .pinball-hint {
    margin: 0;
    max-width: 560px;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    color: var(--muted);
  }
</style>

<script>
  import { createPinball, type PlaceableKind } from '../scripts/games/pinball';

  const canvas = document.getElementById('pinball-canvas') as HTMLCanvasElement;
  const scoreEl = document.getElementById('pinball-score') as HTMLElement;
  const livesEl = document.getElementById('pinball-lives') as HTMLElement;
  const highEl = document.getElementById('pinball-high') as HTMLElement;
  const messageEl = document.getElementById('pinball-message') as HTMLElement;
  const paletteButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('#pinball-palette button'));

  let selected: PlaceableKind | null = null;

  const game = createPinball(canvas, {
    setScore(score) {
      scoreEl.textContent = String(score);
    },
    setLives(lives) {
      livesEl.textContent = '●'.repeat(Math.max(lives, 0));
    },
    setHighScore(score) {
      highEl.textContent = score > 0 ? `Best: ${score}` : '';
    },
    setMessage(text) {
      messageEl.textContent = text ?? '';
    },
    setSelectedKind(kind) {
      selected = kind;
      for (const button of paletteButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.kind === kind));
      }
    },
    setPlacedKinds(kinds) {
      for (const button of paletteButtons) {
        button.classList.toggle('placed', kinds.includes(button.dataset.kind as PlaceableKind));
      }
    },
  });

  for (const button of paletteButtons) {
    button.addEventListener('click', () => {
      const kind = button.dataset.kind as PlaceableKind;
      game.selectKind(selected === kind ? null : kind);
    });
  }
</script>
