---
/* Pixel icons drawn on a 16x16 grid (unless noted), System 7 flavoured.
   Fills use --paper / currentColor so everything inverts in dark mode. */
interface Props {
  name:
    | 'doc' | 'app' | 'folder' | 'home' | 'settings' | 'monogram' | 'happymac' | 'bomb'
    /* Social icons — pinned top-right on the desktop. */
    | 'github' | 'linkedin'
    /* Project icons — one per app on the homepage. */
    | 'grvmkr' | 'schengen' | 'mortgage' | 'survey' | 'memory'
    | 'scribbles' | 'location-alarm' | 'climb' | 'map'
    | 'pinball' | 'dolphin-olympics';
  size?: number;
  class?: string;
}
const { name, size, class: className = '' } = Astro.props;
const px = size ?? 16;
const cls = `mac-icon ${className}`.trim();

/* Filled pixel disc, 16x16 */
const disc: [number, number, number][] = [
  [6, 0, 4], [4, 1, 8], [3, 2, 10], [2, 3, 12], [2, 4, 12], [1, 5, 14],
  [1, 6, 14], [1, 7, 14], [1, 8, 14], [1, 9, 14], [1, 10, 14], [2, 11, 12],
  [2, 12, 12], [3, 13, 10], [4, 14, 8], [6, 15, 4],
];
/* Letter "O" knocked out of the disc */
const letterO: [number, number, number][] = [
  [6, 4, 4],
  [5, 5, 1], [10, 5, 1], [5, 6, 1], [10, 6, 1], [5, 7, 1], [10, 7, 1],
  [5, 8, 1], [10, 8, 1], [5, 9, 1], [10, 9, 1], [5, 10, 1], [10, 10, 1],
  [6, 11, 4],
];
---
{name === 'monogram' && (
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      {disc.map(([x, y, w]) => <rect x={x} y={y} width={w} height="1" />)}
    </g>
    <g fill="var(--knockout, var(--paper))">
      {letterO.map(([x, y, w]) => <rect x={x} y={y} width={w} height="1" />)}
    </g>
  </svg>
)}
{name === 'doc' && (
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <path d="M3 1h7l3 3v11H3z" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <path d="M10 1v3h3" fill="none" stroke="currentColor" stroke-width="1"/>
    <path d="M5 7h6M5 9h6M5 11h4" stroke="currentColor" stroke-width="1"/>
  </svg>
)}
{name === 'app' && (
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <path d="M8 1l7 7-7 7-7-7z" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <path d="M8 5l3 3-3 3-3-3z" fill="currentColor"/>
  </svg>
)}
{name === 'folder' && (
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <path d="M1 3h5l1 2h8v9H1z" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <path d="M1 6h14" stroke="currentColor" stroke-width="1"/>
  </svg>
)}
{name === 'home' && (
  /* House — a folder for home-buying tools. Roof over walls, a chimney
     through the right slope, a door and two windows. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <path d="M3 7h10v8H3z" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <path d="M1 8 8 1l7 7z" fill="var(--paper)" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>
    <rect x="11" y="2" width="2" height="3" fill="currentColor"/>
    <rect x="7" y="10" width="2" height="5" fill="currentColor"/>
    <rect x="4" y="9" width="2" height="2" fill="currentColor"/>
    <rect x="10" y="9" width="2" height="2" fill="currentColor"/>
  </svg>
)}
{name === 'settings' && (
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="1" y="2" width="14" height="3" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <rect x="1" y="7" width="14" height="3" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <rect x="1" y="12" width="14" height="3" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <rect x="4" y="1" width="2" height="5" fill="currentColor"/>
    <rect x="10" y="6" width="2" height="5" fill="currentColor"/>
    <rect x="7" y="11" width="2" height="5" fill="currentColor"/>
  </svg>
)}
{name === 'happymac' && (
  <svg class={cls} width={px || 128} height={(px || 128) * 40 / 32} viewBox="0 0 32 40" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="2" y="1" width="28" height="37" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <rect x="5" y="4" width="22" height="18" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <g fill="currentColor">
      <rect x="9" y="27" width="14" height="2"/>
      <rect x="10" y="32" width="12" height="1"/>
      <rect x="12" y="34" width="8" height="1"/>
    </g>
    <g fill="currentColor">
      <rect x="12" y="7"  width="8"  height="1"/>
      <rect x="12" y="18" width="8"  height="1"/>
      <rect x="10" y="9"  width="1"  height="8"/>
      <rect x="21" y="9"  width="1"  height="8"/>
      <rect x="11" y="8"  width="1"  height="1"/>
      <rect x="20" y="8"  width="1"  height="1"/>
      <rect x="11" y="17" width="1"  height="1"/>
      <rect x="20" y="17" width="1"  height="1"/>
      <rect x="14" y="10" width="1"  height="2"/>
      <rect x="18" y="10" width="1"  height="2"/>
      <rect x="16" y="12" width="1"  height="2"/>
      <rect x="15" y="14" width="2"  height="1"/>
      <rect x="13" y="14" width="1"  height="1"/>
      <rect x="14" y="15" width="1"  height="1"/>
      <rect x="15" y="16" width="3"  height="1"/>
      <rect x="18" y="15" width="1"  height="1"/>
      <rect x="19" y="14" width="1"  height="1"/>
    </g>
  </svg>
)}
{name === 'bomb' && (
  <svg class={cls} width={px || 32} height={px || 32} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="14" cy="20" r="10" fill="currentColor"/>
    <path d="M19 12 q2-5 6-6" fill="none" stroke="currentColor" stroke-width="2"/>
    <g fill="currentColor">
      <rect x="24" y="2" width="2" height="8"/>
      <rect x="21" y="5" width="8" height="2"/>
    </g>
    <path d="M9 16 a7 7 0 0 1 4-3" fill="none" stroke="var(--paper)" stroke-width="2" stroke-linecap="round"/>
  </svg>
)}
{/* ── Project icons ─────────────────────────────────────────────
   Each is a 16×16 pixel-style glyph, monochrome via currentColor
   with knockouts in var(--paper). Kept simple; refine per project. */}
{name === 'grvmkr' && (
  /* Drum grid — 4×4 with a classic backbeat pattern lit up:
     row 0 hi-hat (all 4), row 1 open-hh accent, row 2 snare on 2 & 4,
     row 3 kick on 1 & 3. Paper-colour lines knock out the grid gaps. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="0" y="0" width="16" height="16" fill="var(--paper)"/>
    <g fill="currentColor">
      {/* Row 0 — hi-hat */}
      <rect x="0"  y="0"  width="4" height="4"/>
      <rect x="4"  y="0"  width="4" height="4"/>
      <rect x="8"  y="0"  width="4" height="4"/>
      <rect x="12" y="0"  width="4" height="4"/>
      {/* Row 1 — open hi-hat accent */}
      <rect x="8"  y="4"  width="4" height="4"/>
      {/* Row 2 — snare on 2 & 4 */}
      <rect x="4"  y="8"  width="4" height="4"/>
      <rect x="12" y="8"  width="4" height="4"/>
      {/* Row 3 — kick on 1 & 3 */}
      <rect x="0"  y="12" width="4" height="4"/>
      <rect x="8"  y="12" width="4" height="4"/>
    </g>
    {/* Knockout gridlines — 1px paper stripes carve the 4×4 grid */}
    <g stroke="var(--paper)" stroke-width="1">
      <path d="M4 0v16M8 0v16M12 0v16M0 4h16M0 8h16M0 12h16"/>
    </g>
    {/* Outer ink border */}
    <rect x="0.5" y="0.5" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1"/>
  </svg>
)}
{name === 'schengen' && (
  /* Schengen — the app's own logo: "90" over "180" as a fraction,
     separated by a horizontal rule. Chicago numerals to match the UI. */
  <svg class={cls} width={px} height={px} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <text x="12" y="10" text-anchor="middle" font-size="9" font-weight="bold"
          font-family="'Chicago','ChiKareGo2',Geneva,Verdana,sans-serif"
          fill="currentColor">90</text>
    <line x1="3" y1="12" x2="21" y2="12" stroke="currentColor" stroke-width="1.5" shape-rendering="crispEdges"/>
    <text x="12" y="22" text-anchor="middle" font-size="9" font-weight="bold"
          font-family="'Chicago','ChiKareGo2',Geneva,Verdana,sans-serif"
          fill="currentColor">180</text>
  </svg>
)}
{name === 'mortgage' && (
  /* Line chart — axes with a falling curve: monthly payment vs term length. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {/* Axes */}
    <path d="M3 2v11h11" stroke="currentColor" stroke-width="1" fill="none" shape-rendering="crispEdges"/>
    {/* Curve: high on the left, tailing off to the right */}
    <path d="M4 4 Q 7 6 9 9 T 14 12" stroke="currentColor" stroke-width="1.25" fill="none" stroke-linecap="round"/>
  </svg>
)}
{name === 'survey' && (
  /* House with a magnifying glass — a home survey. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {/* Roof and walls */}
    <path d="M2 8 L8 2 L14 8" stroke="currentColor" stroke-width="1" fill="none" shape-rendering="crispEdges"/>
    <path d="M4 7v7h8V7" stroke="currentColor" stroke-width="1" fill="var(--paper)" shape-rendering="crispEdges"/>
    {/* Door */}
    <rect x="5" y="10" width="2" height="4" fill="currentColor" shape-rendering="crispEdges"/>
    {/* Magnifying glass over the far wall */}
    <circle cx="10.5" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1" fill="var(--paper)"/>
    <path d="M12.5 11.5 L15 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}
{name === 'memory' && (
  /* Number card — three digits shown to memorise. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="1" y="2" width="14" height="12" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <g fill="currentColor">
      {/* "1" */}
      <rect x="3" y="6" width="1" height="4"/>
      <rect x="2" y="7" width="1" height="1"/>
      {/* "2" */}
      <rect x="6" y="6" width="3" height="1"/>
      <rect x="8" y="7" width="1" height="1"/>
      <rect x="6" y="8" width="3" height="1"/>
      <rect x="6" y="9" width="1" height="1"/>
      <rect x="6" y="10" width="3" height="1"/>
      {/* "3" */}
      <rect x="11" y="6" width="3" height="1"/>
      <rect x="13" y="7" width="1" height="3"/>
      <rect x="11" y="8" width="2" height="1"/>
      <rect x="11" y="10" width="3" height="1"/>
    </g>
  </svg>
)}
{name === 'scribbles' && (
  /* Six Second Scribbles — pencil above a squiggle line. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {/* Pencil, tip down-left */}
    <g shape-rendering="crispEdges">
      <rect x="9" y="1" width="5" height="2" fill="currentColor" transform="rotate(45 9 1)"/>
    </g>
    {/* Squiggle */}
    <path d="M2 12 q1.5 -3 3 0 t3 0 t3 0 t3 0" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
  </svg>
)}
{name === 'location-alarm' && (
  /* Location Alarm — the app's own icon: a pin with an alarm-clock face
     inside (two hands) and small bell ears above. Ported from
     composeApp/src/main/res/drawable/ic_location_alarm.xml. */
  <svg class={cls} width={px} height={px} viewBox="0 0 50 50" aria-hidden="true" focusable="false">
    {/* Pin outline (paper fill so the clock face reads inside it) */}
    <path d="M42.404,19.465C42.404,21.128 41.687,23.746 40.346,26.92C39.034,30.028 37.221,33.446 35.248,36.625C33.271,39.811 31.17,42.694 29.302,44.755C28.364,45.789 27.53,46.566 26.839,47.068C26.192,47.537 25.866,47.623 25.809,47.638C25.804,47.639 25.802,47.639 25.8,47.64C25.777,47.637 25.691,47.623 25.532,47.558C25.325,47.475 25.05,47.33 24.708,47.1C24.02,46.638 23.191,45.92 22.259,44.959C20.401,43.042 18.309,40.333 16.341,37.271C14.376,34.215 12.573,30.867 11.267,27.694C9.945,24.482 9.202,21.614 9.202,19.465C9.202,10.462 16.609,3.117 25.803,3.117C34.997,3.117 42.404,10.462 42.404,19.465Z"
          fill="var(--paper)" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
    {/* Clock hand — pointing up (12 o'clock) */}
    <path d="M23,9.281C23,8.021 23.975,7 25.177,7C26.379,7 27.354,8.021 27.354,9.281V20.688H23V9.281Z"
          fill="currentColor"/>
    {/* Clock hand — angled to lower right */}
    <path d="M23,20.659L26.27,17.646L33.458,26.212C34.252,27.158 34.163,28.6 33.261,29.432C32.358,30.264 30.982,30.171 30.188,29.225L23,20.659Z"
          fill="currentColor"/>
    {/* Alarm bell ears */}
    <path d="M42.923,1.225L46.791,5.876A2,2 95.467,0 1,46.532 8.693L46.296,8.889A2,2 73.089,0 1,43.479 8.63L39.611,3.979A2,2 73.089,0 1,39.87 1.162L40.106,0.966A2,2 95.467,0 1,42.923 1.225z"
          fill="currentColor"/>
    <path d="M8.147,1.538L4.279,6.189A2,2 88.569,0 0,4.538 9.006L4.774,9.202A2,2 84.22,0 0,7.59 8.943L11.459,4.292A2,2 88.569,0 0,11.2 1.475L10.964,1.279A2,2 88.569,0 0,8.147 1.538z"
          fill="currentColor"/>
  </svg>
)}
{name === 'github' && (
  /* Octocat silhouette — solid pixel head with two knocked-out eyes
     and a splayed set of tentacle feet below. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <g fill="currentColor">
      {/* Head — rounded top */}
      <rect x="4" y="1" width="8" height="1"/>
      <rect x="3" y="2" width="10" height="1"/>
      <rect x="2" y="3" width="12" height="1"/>
      <rect x="1" y="4" width="14" height="1"/>
      <rect x="1" y="5" width="14" height="2"/>
      <rect x="1" y="7" width="14" height="3"/>
      <rect x="2" y="10" width="12" height="1"/>
      <rect x="3" y="11" width="10" height="1"/>
      {/* Tentacle feet */}
      <rect x="4" y="12" width="3" height="1"/>
      <rect x="9" y="12" width="3" height="1"/>
      <rect x="4" y="13" width="1" height="1"/>
      <rect x="6" y="13" width="1" height="1"/>
      <rect x="9" y="13" width="1" height="1"/>
      <rect x="11" y="13" width="1" height="1"/>
    </g>
    <g fill="var(--paper)">
      {/* Eyes */}
      <rect x="3" y="5" width="2" height="2"/>
      <rect x="11" y="5" width="2" height="2"/>
    </g>
  </svg>
)}
{name === 'linkedin' && (
  /* Filled square badge with a lowercase "in" carved out in paper,
     the way the real mark reads on a screen full of tiles. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="0" y="0" width="16" height="16" fill="currentColor"/>
    <g fill="var(--paper)">
      {/* i — dot then shaft */}
      <rect x="3" y="3" width="2" height="2"/>
      <rect x="3" y="7" width="2" height="6"/>
      {/* n — top bar with two legs */}
      <rect x="7" y="7" width="6" height="2"/>
      <rect x="7" y="9" width="2" height="4"/>
      <rect x="11" y="9" width="2" height="4"/>
    </g>
  </svg>
)}
{name === 'climb' && (
  /* Mountains — a solid rear peak with a jagged snow cap, overlapped
     by a shorter front peak that gives depth. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {/* Rear peak — filled */}
    <path d="M2 14 L10 2 L15 14 Z" fill="currentColor"/>
    {/* Snow cap — zigzag lower edge sitting near the summit */}
    <path d="M7.5 6 L8.5 5 L9.5 6 L10.5 5 L11.5 6 L10 2 Z" fill="var(--paper)"/>
    {/* Front peak — paper with outline, in front of rear */}
    <path d="M0 14 L5 7 L11 14 Z" fill="var(--paper)" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>
  </svg>
)}
{name === 'pinball' && (
  /* Pinball — a ball above two angled flippers, framed like a tiny table. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <rect x="0.5" y="0.5" width="15" height="15" fill="var(--paper)" stroke="currentColor" stroke-width="1"/>
    <circle cx="8" cy="4" r="1.5" fill="currentColor"/>
    <circle cx="4.5" cy="9" r="1" fill="currentColor"/>
    <circle cx="11.5" cy="9" r="1" fill="currentColor"/>
    <g stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <path d="M3 13.5 6.75 11.25"/>
      <path d="M13 13.5 9.25 11.25"/>
    </g>
  </svg>
)}
{name === 'dolphin-olympics' && (
  /* Dolphin Olympics — a dolphin mid-leap over a wavy waterline. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <rect x="0.5" y="0.5" width="15" height="15" fill="var(--paper)" stroke="currentColor" stroke-width="1" shape-rendering="crispEdges"/>
    <path d="M1 12.5q1.5-1.5 3 0t3 0t3 0t3 0" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="crispEdges"/>
    <g fill="currentColor">
      <ellipse cx="8" cy="6.5" rx="3.6" ry="2" transform="rotate(-25 8 6.5)"/>
      <path d="M10.8 5.2 13 4 11.6 6.4Z"/>
      <path d="M5.6 7.6 3.6 9.4 5.2 6.6Z"/>
      <path d="M7.6 4.6 8.6 2 9.4 4.8Z"/>
    </g>
  </svg>
)}
{name === 'map' && (
  /* Folded map — three panels and a pin, keeping the small desktop glyph
     legible at Finder-icon scale. */
  <svg class={cls} width={px} height={px} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <path d="M1 3.5 5.75 2l4.5 1.5L15 2v10.5L10.25 14l-4.5-1.5L1 14z" fill="var(--paper)" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>
    <path d="M5.75 2v10.5M10.25 3.5V14" fill="none" stroke="currentColor" stroke-width="1"/>
    <path d="M8 4.5a2 2 0 0 0-2 2c0 1.5 2 3.5 2 3.5s2-2 2-3.5a2 2 0 0 0-2-2Z" fill="currentColor"/>
    <rect x="7.5" y="6" width="1" height="1" fill="var(--paper)"/>
  </svg>
)}
