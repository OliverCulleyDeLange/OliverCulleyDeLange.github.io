---
import { getCollection } from 'astro:content';
import MacIcon from './MacIcon.astro';
import ProjectRating from './ProjectRating.astro';
import { iconFor } from '../lib/project-icons';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.rating - a.data.rating || a.data.order - b.data.order
);
---
<div class="projects-explainer">
  <header class="projects-intro">
    <h1>Projects</h1>
    <p>A collection of tools, games and experiments. Mostly vibes</p>
  </header>

  <section class="projects-section" aria-labelledby="project-list-heading">
    <h2 class="section-heading" id="project-list-heading">Applications</h2>
    <ul class="project-cards">
      {projects.map(project => {
        const { name, tagline, rating, appUrl, devAppUrl, appLabel, githubUrl, standalone } = project.data;
        const resolvedAppUrl = import.meta.env.DEV && devAppUrl ? devAppUrl : appUrl;
        // Standalone apps have no Info page: the app is the whole experience.
        const primaryHref = standalone ? resolvedAppUrl! : `/projects/${project.id}/`;
        return (
          <li class="project-card">
            <div class="project-card-body">
              <MacIcon name={iconFor(project.id) as any} size={24} />
              <div>
                <h3><a href={primaryHref}>{name}</a></h3>
                <p>{tagline}</p>
                <ProjectRating rating={rating} />
              </div>
            </div>
            <div class="project-card-actions">
              {githubUrl && (
                <a href={githubUrl} class="icon-link" target="_blank" rel="noopener" aria-label={`${name} on GitHub`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </a>
              )}
              {!standalone && (
                <a href={primaryHref} class="btn btn-ghost btn-sm">Get Info</a>
              )}
              {resolvedAppUrl && (
                <a
                  href={resolvedAppUrl}
                  class="btn btn-primary btn-sm"
                  target="_blank"
                  rel="noopener"
                  data-project-id={project.id}
                >{appLabel ?? 'Open'}</a>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</div>
